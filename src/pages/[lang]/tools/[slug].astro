---
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import SeoHead from '../../../components/layout/SeoHead.astro';
import ToolContent from '../../../components/layout/ToolContent.astro';
import DagetHunter from '../../../components/daget-hunter/index.jsx';
import RepeaterText from '../../../components/repeater-text/index.jsx';
import ExtractUrl from '../../../components/extract-url/index.jsx';
import ExtractPhone from '../../../components/extract-phone/index.jsx';
import ReplaceText from '../../../components/replace-text/index.jsx';
import WordCounter from '../../../components/word-counter/index.jsx';
import CaseConverter from '../../../components/case-converter/index.jsx';
import Base64Codec from '../../../components/base64-codec/index.jsx';
import JsonFormatter from '../../../components/json-formatter/index.jsx';
import LoremIpsum from '../../../components/lorem-ipsum/index.jsx';
import PasswordGenerator from '../../../components/password-generator/index.jsx';
import CvBuilder from '../../../components/cv-builder/index.jsx';
import CoverLetter from '../../../components/cover-letter/index.jsx';
import { LOCALES, TOOLS, getLocale, toolDict, toolSlug, localePath, footerLinks } from '../../../i18n/index.js';
import '../../../styles/global.css';

export function getStaticPaths() {
  const paths = [];
  for (const loc of LOCALES) {
    for (const tool of TOOLS) {
      paths.push({
        params: { lang: loc.code, slug: toolSlug(loc.code, tool.id) },
        props: { toolId: tool.id },
      });
    }
  }
  return paths;
}

const { lang } = Astro.params;
const { toolId } = Astro.props;
const s = getLocale(lang);
const toolMeta = s.tools[toolId];
const toolConfig = TOOLS.find((x) => x.id === toolId);
const currentPath = Astro.url.pathname;
const canonicalPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const links = footerLinks(lang);
---

<html lang={lang}>
  <SeoHead lang={lang} title={toolMeta.title} description={toolMeta.desc} path={canonicalPath} toolId={toolId} themeColor={toolConfig.themeColor} />
  <body class="bg-[#f9fafb]">
    <Header lang={lang} currentPath={currentPath} allToolsLabel={s.nav.allTools} langLabel={s.nav.langLabel} />
    <main>
      <nav aria-label="Breadcrumb" class="max-w-[680px] mx-auto px-4 pt-4">
        <ol class="flex items-center gap-1.5 text-xs text-gray-500">
          <li>
            <a href={localePath(lang, 'home')} class="hover:text-[#0e0f0c] transition-colors">{s.seo?.breadcrumbHome || 'Home'}</a>
          </li>
          <li aria-hidden="true" class="text-gray-400">/</li>
          <li class="text-[#0e0f0c] font-medium" aria-current="page">{toolMeta.title.split(' — ')[0]}</li>
        </ol>
      </nav>
      {toolId === 'daget-hunter' && <DagetHunter client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'repeater-text' && <RepeaterText client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'extract-url' && <ExtractUrl client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'extract-phone' && <ExtractPhone client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'replace-text' && <ReplaceText client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'word-counter' && <WordCounter client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'case-converter' && <CaseConverter client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'base64-codec' && <Base64Codec client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'json-formatter' && <JsonFormatter client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'lorem-ipsum' && <LoremIpsum client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'password-generator' && <PasswordGenerator client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'cv-builder' && <CvBuilder client:idle lang={lang} t={toolDict(lang, toolId)} />}
      {toolId === 'cover-letter' && <CoverLetter client:idle lang={lang} t={toolDict(lang, toolId)} />}
      <ToolContent s={s} lang={lang} toolId={toolId} />
    </main>
    <Footer tagline={s.footer.tagline} links={links} />
  </body>
</html>