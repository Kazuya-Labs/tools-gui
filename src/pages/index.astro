---
import DagetHunter from '../components/daget-hunter/index.jsx';
import '../styles/global.css'

// ====== GANTI dengan domain asli kamu setelah deploy ======
const SITE_URL = 'https://tools.kazuyatech.id';

const PAGE_TITLE = 'DagetKode — Sebar & Klaim Link Dana Kaget dengan Aman';
const PAGE_DESCRIPTION =
  'DagetKode membungkus link dana kaget jadi kode unik sebelum disebar ke grup WA. Anggota komunitas tinggal decode di sini untuk klaim link asli, cepat dan aman.';
const OG_IMAGE = `${SITE_URL}/og-image.png`; // taruh file og-image.png (1200x630) di folder /public

const canonicalURL = new URL(Astro.url.pathname, SITE_URL).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'DagetKode',
  description: PAGE_DESCRIPTION,
  url: SITE_URL,
  inLanguage: 'id-ID',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'IDR',
  },
};
---

<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO -->
		<title>{PAGE_TITLE}</title>
		<meta name="description" content={PAGE_DESCRIPTION} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#1473E6" />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="DagetKode" />
		<meta property="og:locale" content="id_ID" />
		<meta property="og:title" content={PAGE_TITLE} />
		<meta property="og:description" content={PAGE_DESCRIPTION} />
		<meta property="og:image" content={OG_IMAGE} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="DagetKode — encode dan decode link dana kaget" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={PAGE_TITLE} />
		<meta name="twitter:description" content={PAGE_DESCRIPTION} />
		<meta name="twitter:image" content={OG_IMAGE} />

		<!-- Preconnect ke CDN ikon supaya nggak nahan render -->
		<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons@latest/tabler-icons.min.css" />

		<!-- Structured data (membantu Google paham ini "aplikasi web") -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body>
		<DagetHunter client:load />
	</body>
</html>