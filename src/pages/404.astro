---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHead from '../components/layout/SeoHead.astro';
import { Icon } from 'astro-icon/components';
import { getLocale } from '../i18n/index.js';
import '../styles/global.css';

const s = getLocale('id');
const currentPath = Astro.url.pathname;
const pageTitle = `404 — ${s.error.heading} | ToolKu`;
const pageDesc = s.error.desc;
---

<html lang="id">
  <SeoHead lang="id" title={pageTitle} description={pageDesc} path={currentPath} kind="error" noindex themeColor="#9fe870" />
  <body class="bg-[#f9fafb]">
    <Header lang="id" currentPath={currentPath} allToolsLabel={s.nav.allTools} langLabel={s.nav.langLabel} />
    <main class="max-w-[680px] mx-auto px-4 py-20 text-center">
      <div class="inline-flex w-20 h-20 bg-gray-100 rounded-full items-center justify-center mb-6">
        <Icon name="mdi:alert" class="text-3xl text-gray-400" />
      </div>
      <h1 class="text-5xl font-black text-[#0e0f0c] mb-3" style="font-family:Inter,sans-serif;line-height:0.85;font-feature-settings:'calt'">404</h1>
      <p class="text-lg font-semibold text-gray-600 mb-2" style="font-family:Inter,sans-serif;font-feature-settings:'calt'">{s.error.heading}</p>
      <p class="text-sm text-gray-400 mb-8 max-w-sm mx-auto" style="font-family:Inter,sans-serif;font-weight:400;font-feature-settings:'calt'">{s.error.desc}</p>
      <a href="/id/" class="inline-flex items-center gap-2 bg-[#9fe870] text-[#163300] border-none rounded-full px-6 py-3 text-sm font-semibold cursor-pointer no-underline hover:scale-105 active:scale-95 transition-transform" style="font-family:Inter,sans-serif;font-feature-settings:'calt'">
        <Icon name="mdi:home" class="text-base" /> {s.error.back}
      </a>
    </main>
    <Footer tagline={s.footer.tagline} />
  </body>
</html>