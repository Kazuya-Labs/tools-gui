---
import { Icon } from 'astro-icon/components';
import { LOCALES } from '../../i18n/index.js';

const {
  lang = 'id',
  currentPath = '/',
  allToolsLabel = 'Semua Tools',
  langLabel = 'Bahasa',
} = Astro.props;

const parts = currentPath.split('/').filter(Boolean).slice(1);
const rest = parts.length ? `/${parts.join('/')}` : '/';
const homePath = `/${lang}/`;
const swapUrl = (code) => (rest === '/' ? `/${code}/` : `/${code}${rest}`);
---

<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <a href={homePath} class="flex items-center gap-2.5 no-underline">
      <div class="w-8 h-8 bg-[#9fe870] rounded-full flex items-center justify-center flex-shrink-0">
        <span class="text-sm font-bold text-[#163300]" style="font-feature-settings:'calt'">T</span>
      </div>
      <span class="text-lg font-bold text-[#0e0f0c]" style="font-family:Inter,sans-serif;font-weight:800;font-feature-settings:'calt'">ToolKu</span>
    </a>
    <nav class="flex items-center gap-2">
      <a href={homePath} class={`hidden sm:inline-flex px-3 py-1.5 rounded-full text-sm font-semibold no-underline transition-all hover:scale-105 ${currentPath === homePath ? 'bg-[#9fe870] text-[#163300]' : 'text-[#0e0f0c] hover:bg-gray-100'}`} style="font-feature-settings:'calt'">{allToolsLabel}</a>
      <div class="flex items-center gap-1.5 bg-gray-100 rounded-full px-3 py-1.5">
        <Icon name="mdi:translate" class="text-base text-gray-600 shrink-0" />
        <select id="lang-switch" class="bg-transparent text-sm font-semibold text-[#0e0f0c] outline-none cursor-pointer max-w-[130px]" aria-label={langLabel}>
          {LOCALES.map((loc) => (
            <option value={swapUrl(loc.code)} selected={loc.code === lang}>{loc.label}</option>
          ))}
        </select>
      </div>
    </nav>
  </div>
</header>
<script>
  const sel = document.getElementById('lang-switch');
  sel?.addEventListener('change', (e) => {
    window.location.href = e.target.value;
  });
</script>