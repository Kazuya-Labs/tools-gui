---
const { tagline = 'Kumpulan tools online gratis', links = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-[#0e0f0c] text-white mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 bg-[#9fe870] rounded-full flex items-center justify-center flex-shrink-0">
          <span class="text-xs font-bold text-[#163300]" style="font-feature-settings:'calt'">T</span>
        </div>
        <span class="text-sm font-bold text-white" style="font-family:Inter,sans-serif;font-weight:700;font-feature-settings:'calt'">ToolKu</span>
      </div>
      <p class="text-xs text-gray-400" style="font-feature-settings:'calt'">&copy; {year} ToolKu &middot; tools.kazuyatech.id &middot; {tagline}</p>
    </div>
    {links.length > 0 && (
      <nav aria-label="Footer" class="mt-8 pt-6 border-t border-white/10 flex flex-wrap justify-center gap-2">
        {links.map((l) => (
          <a
            href={l.href}
            class="text-xs text-gray-400 hover:text-[#9fe870] px-3 py-1.5 rounded-full border border-white/10 hover:border-[#9fe870]/40 transition-colors no-underline"
            style="font-feature-settings:'calt'"
          >{l.label}</a>
        ))}
      </nav>
    )}
  </div>
</footer>