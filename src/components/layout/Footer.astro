---
const { tagline = 'Kumpulan tools online gratis' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-[#0e0f0c] text-white mt-16">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2.5">
        <div class="w-7 h-7 bg-[#9fe870] rounded-full flex items-center justify-center">
          <span class="text-xs font-bold text-[#163300]" style="font-feature-settings:'calt'">T</span>
        </div>
        <span class="text-sm font-bold text-white" style="font-family:Inter,sans-serif;font-weight:700;font-feature-settings:'calt'">ToolKu</span>
      </div>
      <p class="text-xs text-gray-400" style="font-feature-settings:'calt'">&copy; {year} ToolKu &middot; tools.kazuyatech.id &middot; {tagline}</p>
    </div>
  </div>
</footer>